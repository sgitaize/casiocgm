{
  "name": "casiocgm",
  "author": "simon",
  "version": "2.3.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "CasioCGM",
    "uuid": "6a8bead9-d7d1-4183-bbb6-e351208ac33f",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "health",
      "configurable"
    ],
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_DSEG_TIME48",
          "file": "fonts/DSEG14Classic-Bold.ttf",
          "characterRegex": "[0-9:. -]",
          "size": 48
        },
        {
          "type": "font",
          "name": "FONT_DSEG_TIME38",
          "file": "fonts/DSEG14Classic-Bold.ttf",
          "characterRegex": "[0-9:]",
          "size": 38
        },
        {
          "type": "font",
          "name": "FONT_DSEG_DATE16",
          "file": "fonts/DSEG14Classic-Bold.ttf",
          "characterRegex": "[0-9. -]",
          "size": 16
        },
        {
          "type": "font",
          "name": "FONT_DSEG_COMP22",
          "file": "fonts/DSEG14Classic-Bold.ttf",
          "characterRegex": "[0-9. +NOCBGLD-]",
          "size": 22
        },
        {
          "type": "font",
          "name": "FONT_DSEG_COMP22_REG",
          "file": "fonts/DSEG14Classic-Regular.ttf",
          "characterRegex": "[0-9. +-]",
          "size": 22
        }
      ]
    },
    "messageKeys": [
      "NS_URL",
      "NS_TOKEN",
      "NS_UNITS",
      "NS_HIGH",
      "NS_LOW",
      "NS_STALE_MIN",
      "COLOR_BG",
      "COLOR_FG",
      "COLOR_ACCENT",
      "COLOR_CGM_OK",
      "COLOR_CGM_HIGH",
      "COLOR_CGM_LOW",
      "COMPLICATION",
      "LABEL_TOP_LEFT",
      "LABEL_TOP_RIGHT",
      "LABEL_BOTTOM",
      "FIRST_WEEKDAY",
      "DATE_FORMAT",
      "SHAKE_2ND",
      "WDAY_LANG",
      "SHOW_SECONDS",
      "COLOR_GHOST",
      "COLOR_LABEL_TOP",
      "GHOST_ENABLED",
      "COLOR_CGM_BANNER",
      "COLOR_TIME2_BG",
      "COLOR_CGM_INFO",
      "BACKLIGHT_ENABLED",
      "COLOR_BACKLIGHT",
      "CGM_VALUE",
      "CGM_DELTA",
      "CGM_TREND",
      "CGM_AGE",
      "STEPS",
      "HR",
      "WEATHER_TEMP",
      "WEATHER_ICON",
      "BATT_PCT",
      "CGM_BOX_ENABLED",
      "COLOR_CGM_BOX_BG",
      "GHOST_COMP_ENABLED",
      "VIBE_ON_LOW",
      "VIBE_ON_HIGH",
      "CGM_STATUS",
      "CGM_TS",
      "CGM_SGV",
      "REQUEST_BG"
